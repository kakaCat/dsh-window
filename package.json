{
  "name": "dsh-window",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 窗口插件：续接（continuation）与分叉（branch）双场景开窗、运行登记与后续完成回调的通用基础",
  "license": "MIT",
  "author": "kakaCat <253834671@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakaCat/dsh-window.git"
  },
  "homepage": "https://github.com/kakaCat/dsh-window#readme",
  "bugs": "https://github.com/kakaCat/dsh-window/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "window",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^20.11.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  }
}
